[Unit]
Description=EliteCar monitoring landing page
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/elitecar-monitor
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /var/www/elitecar-monitor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
